# LLM Provider: "lm_studio" or "gemini"
LLM_PROVIDER=lm_studio

# LM Studio (Local)
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL_NAME=google/gemma-4-e4b
LLM_TEMPERATURE=0.2

# Gemini (Cloud)
# Get a free key at https://aistudio.google.com/apikey
# Options: gemini-flash-latest, gemini-pro-latest, gemini-3.6-flash
# GEMINI_API_KEY=your-api-key-here
# GEMINI_MODEL_NAME=gemini-flash-latest

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Delay (seconds) between LLM calls to respect rate limits.
# Gemini free tier = 5 req/min, so ~13s spacing stays safe.
# Set to 0 for local LM Studio (no rate limit).
LLM_CALL_DELAY=13

# --- Transcription (Speech-to-Text) ---
# Whisper model size: tiny, base, small, medium, large-v3
# tiny/base are CPU-friendly and low-memory (good for laptops)
WHISPER_MODEL_SIZE=base
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu
