# LLM Provider: "groq" (recommended), "gemini", or "lm_studio"
LLM_PROVIDER=groq

# LM Studio (Local)
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL_NAME=google/gemma-4-e4b
LLM_TEMPERATURE=0.2

# Groq (Cloud, fast + generous free tier)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL_NAME=openai/gpt-oss-20b

# Gemini (Cloud)
# Get a free key at https://aistudio.google.com/apikey
# Options: gemini-flash-latest, gemini-pro-latest, gemini-3.6-flash
# GEMINI_API_KEY=your-api-key-here
# GEMINI_MODEL_NAME=gemini-flash-latest

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Delay (seconds) between LLM calls to respect rate limits.
# Groq's free tier is generous, so 0 is fine.
LLM_CALL_DELAY=0

# --- Preprocessing / chunking ---
CHUNK_SIZE_CHARS=6000
CHUNK_OVERLAP_CHARS=400
CHUNK_THRESHOLD_CHARS=6000

# --- Transcription (Speech-to-Text) ---
# Whisper model size: tiny, base, small, medium, large-v3
# tiny/base are CPU-friendly and low-memory (good for laptops)
WHISPER_MODEL_SIZE=base
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu

